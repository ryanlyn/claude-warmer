{
  "name": "@ryanlyn/claude-warmer",
  "version": "0.1.3",
  "exports": "./src/index.tsx",
  "tasks": {
    "dev": "deno run -A src/index.tsx",
    "start": "deno run -A src/index.tsx",
    "test": "deno test -A --no-check tests/lib tests/components",
    "test:coverage": "deno test -A --no-check --coverage=coverage tests/lib tests/components && deno coverage coverage --exclude=src/index.tsx",
    "test:integration": "deno test -A --no-check tests/integration",
    "test:e2e": "deno test -A --no-check tests/e2e",
    "check": "deno fmt --check && deno lint && deno task test:coverage",
    "build:npm": "deno run -A scripts/build-npm.ts",
    "prepublish": "deno task check && deno task build:npm"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:react@^18.3.1",
    "lib": ["DOM", "ES2022", "deno.ns"],
    "strict": true
  },
  "imports": {
    "react": "npm:react@^18.3.1",
    "react/jsx-runtime": "npm:react@^18.3.1/jsx-runtime",
    "ink": "npm:ink@^5.2.1",
    "@inkjs/ui": "npm:@inkjs/ui@^2.0.0",
    "ink-testing-library": "npm:ink-testing-library@^4.0.0",
    "node-pty": "npm:node-pty@^1.1.0",
    "@types/node": "npm:@types/node@^25.5.2",
    "@types/react": "npm:@types/react@^19.2.14",
    "@deno/dnt": "jsr:@deno/dnt@^0.42.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
    "@std/testing/mock": "jsr:@std/testing@^1.0.0/mock",
    "@std/testing/time": "jsr:@std/testing@^1.0.0/time"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "include": ["src/", "scripts/", "tests/"],
    "exclude": ["dist/", "npm/", "coverage/", "node_modules/"],
    "lineWidth": 120,
    "singleQuote": true,
    "semiColons": true,
    "useTabs": false,
    "indentWidth": 2
  },
  "lint": {
    "include": ["src/", "scripts/", "tests/"],
    "exclude": ["dist/", "npm/", "coverage/", "node_modules/", "tests/e2e/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "no-unused-vars"]
    }
  },
  "exclude": ["dist/", "npm/", "coverage/", "node_modules/"]
}
